AUTH_SECRET=replace-with-a-long-random-value
BACKEND_URL=http://127.0.0.1:8000/api

# --- Routing (all optional; defaults work without keys) -----------------------
# Fallback order; providers without a key/URL are skipped.
ROUTING_PROVIDERS=brouter,graphhopper,valhalla
# BROUTER_URL=https://brouter.de/brouter            # point at a self-hosted BRouter for real traffic
# GRAPHHOPPER_API_KEY=
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NEXT_PUBLIC_TILES_LIGHT=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILES_DARK=                             # unset = OSM tiles with a dark filter

# --- Limits ---------------------------------------------------------------------
# MAX_ROUTE_KM=300
# RATE_LIMIT_ROUTING_PER_MIN=30
# RATE_LIMIT_GEOCODE_PER_MIN=60
# GUEST_ROUTES_PER_DAY=20
# GUEST_MAX_ROUTE_KM=80
# GUEST_AI_MESSAGES_PER_DAY=8
# MEMBER_AI_MESSAGES_PER_DAY=60

# --- AI route assistant -----------------------------------------------------------
# anthropic = Claude; openai = any OpenAI-compatible server (Ollama, vLLM, Together).
# Unset: Claude when ANTHROPIC_API_KEY is set, otherwise the OpenAI-compatible server.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# AI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# AI_OPENAI_MODEL=llama3.1
# AI_OPENAI_API_KEY=
# AI_MAX_OUTPUT_TOKENS=
# AI_MAX_STEPS=6
# AI_MAX_TOOL_CALLS=8
# AI_POW_BITS=14
# Only for evals/run.ts (lifts quotas for requests carrying this token; 16+ chars):
# AI_EVAL_TOKEN=
